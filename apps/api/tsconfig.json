{
    "compilerOptions": {
        "target": "es2025",
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "rootDir": "./src",
        "outDir": "./dist",

        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}